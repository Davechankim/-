{
  "mcpServers": {
    "design-toolbox-playwright": {
      "type": "stdio",
      "command": "bash",
      "args": [
        "-c",
        "exec python3 \"$CLAUDE_PROJECT_DIR/.claude/skills/design-toolbox/scripts/cloud.py\" playwright"
      ]
    },
    "design-toolbox-21st": {
      "type": "http",
      "url": "https://21st.dev/api/mcp",
      "headers": {
        "Authorization": "Bearer ${API_KEY_21ST}"
      }
    },
    "design-toolbox-figma": {
      "type": "http",
      "url": "https://mcp.figma.com/mcp"
    }
  }
}
